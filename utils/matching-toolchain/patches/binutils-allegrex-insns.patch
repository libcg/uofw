MIPS/Allegrex: add halt and accept the VFPU sync register $255

The original Allegrex (PSP) firmware uses two instruction words that the
assembler rejects:

  halt              0x70000000  SPECIAL2 function 0: stop the pipeline
                                until an interrupt is pending.  The name
                                is the one used by pspdev's pspsh
                                assembler/disassembler (psplinkusb), uOFW
                                (pspHalt, common.S), prxtool and PPSSPP.
  mfvc $zero, $255  0x486000ff  VFPU synchronisation: a read of the
                                pseudo control register 127.  objdump
                                already prints it this way, but the
                                assembler only accepted $128-$143.

Both are used e.g. by the 6.60 threadman module (idle loops and VFPU
context switch).  The existing mfvc/mtvc entries are reused: only the
register name and the range check of the VFPU control register operand
are extended, with $255 as the single new value.

---
 gas/config/tc-mips.c                      | 6 ++++--
 gas/testsuite/gas/mips/allegrex-vcr-err.d | 3 +++
 gas/testsuite/gas/mips/allegrex-vcr-err.l | 4 ++++
 gas/testsuite/gas/mips/allegrex-vcr-err.s | 4 ++++
 gas/testsuite/gas/mips/allegrex.d         | 4 ++++
 gas/testsuite/gas/mips/allegrex.s         | 4 ++++
 gas/testsuite/gas/mips/mips.exp           | 1 +
 include/opcode/vfpu.h                     | 1 +
 opcodes/mips-opc.c                        | 1 +
 9 files changed, 26 insertions(+), 2 deletions(-)
 create mode 100644 gas/testsuite/gas/mips/allegrex-vcr-err.d
 create mode 100644 gas/testsuite/gas/mips/allegrex-vcr-err.l
 create mode 100644 gas/testsuite/gas/mips/allegrex-vcr-err.s

diff --git a/gas/config/tc-mips.c b/gas/config/tc-mips.c
index 5c8d04d6..a14fdcdd 100644
--- a/gas/config/tc-mips.c
+++ b/gas/config/tc-mips.c
@@ -2947,7 +2947,8 @@ enum mips_vfpu_reg_shape {
     {"$140",	RTYPE_VFPU_CTR | 140}, \
     {"$141",	RTYPE_VFPU_CTR | 141}, \
     {"$142",	RTYPE_VFPU_CTR | 142}, \
-    {"$143",	RTYPE_VFPU_CTR | 143}
+    {"$143",	RTYPE_VFPU_CTR | 143}, \
+    {"$255",	RTYPE_VFPU_CTR | 255}
 
 static const struct regname reg_names[] = {
   GENERIC_REGISTER_NUMBERS,
@@ -7074,7 +7075,8 @@ match_vfpu_operand (struct mips_arg_info *arg,
     if (!match_reg (arg, OP_REG_VFPU_CTR, &uval))
       return false;
 
-    if (!(uval >= VF_MIN_VCR && uval <= VF_MAX_VCR)) {
+    /* $255 is not a register: "mfvc $zero, $255" synchronises the VFPU.  */
+    if (!(uval >= VF_MIN_VCR && uval <= VF_MAX_VCR) && uval != VF_SYNC_VCR) {
       set_insn_error (arg->argnum, _("invalid coprocessor register"));
       return false;
     }
